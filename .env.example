# ==============================================================================
# Bandit Configuration (.env)
# ==============================================================================

# Server Network Configuration
PORT=8099
HOST=0.0.0.0

# Security / Access Control
# Set an authentication token/password to protect the stream.
# If left empty, anyone who can reach the port can listen.
AUTH_TOKEN=change-this-secure-token

# Audio Capture Device
# On Linux: 'default', 'hw:1,0', 'sysdefault:CARD=PCH', etc. (run 'npm run list-devices')
# On Windows: 'audio="Microphone (Realtek Audio)"'
# On macOS: '":default"' or '":0"'
# Synthetic test mode: 'test' (generates 440Hz test tone + periodic blips without physical mic)
AUDIO_DEVICE=default

# Audio Driver
# Options: 'auto', 'alsa', 'pulse', 'dshow', 'avfoundation', 'lavfi' (test generator)
AUDIO_DRIVER=auto

# Audio Quality & Latency Parameters
# Sample rate in Hz: 16000, 24000, 44100, 48000 (24000Hz is ideal balance of voice fidelity & low latency)
SAMPLE_RATE=24000

# Channel count: 1 (mono, recommended for surveillance) or 2 (stereo)
CHANNELS=1

# Audio Chunk Interval in milliseconds (latency vs packet overhead)
# Recommended: 30 to 50ms for ultra-low latency real-time streaming
CHUNK_MS=40

# Capture Mode:
# 'continuous' -> Keeps microphone capture active at all times
# 'on-demand'  -> Starts audio capture only when at least one client is connected
CAPTURE_MODE=continuous

# Continuous Microphone Auto-Discovery:
# When enabled (true), if no physical microphone is detected at startup or if a mic is disconnected,
# Bandit will continuously probe the host in the background and auto-acquire the microphone as soon as it is plugged in.
AUTO_SEARCH_MIC=true
MIC_SEARCH_INTERVAL=3000

# EasyEffects DSP Real-Time Sound Editing Engine:
# Options: 'broadcast' (Clean Voice), 'whisper' (Whisper & Surveillance Boost), 'noise_rejection' (Heavy Denoise), 'raw' (Bypass)
DSP_PRESET=broadcast

# 48-Hour Automatic Recording System:
# Automatically records host microphone into maximum 1-hour files and rolls on a 48-hour cycle.
# Saved audio older than 48 hours is automatically purged from the system.
AUTO_RECORDING_ENABLED=true
RECORDING_SEGMENT_SECONDS=3600
RECORDING_RETENTION_HOURS=48
RECORDINGS_DIR=./recordings
RECORDING_FORMAT=mp3
RECORDING_BITRATE=64k

# Local OpenAI Whisper STT & Audio Analysis:
# Runs in its own local Docker container (bandit-whisper) using the 'small' model.
# Completely private, offline, with word-level timestamps and auto-detection of up to 4 speakers.
WHISPER_BASE_URL=http://localhost:8000/v1
WHISPER_MODEL=small
WHISPER_MAX_SPEAKERS=4
WHISPER_MIN_SEGMENT_SEC=0.8

# Optional: Cloud OpenAI API fallback (leave empty to use local container)
OPENAI_API_KEY=
